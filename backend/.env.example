# Optional API token for tonapi.io — without it the public free tier (~1 RPS) applies.
TON_PNL_TONAPI_TOKEN=

# How many events to scan per wallet (newest first). Increase for power users.
TON_PNL_MAX_EVENTS_PER_WALLET=1000

# Cache TTL for /api/wallet/{address}/pnl, in seconds.
TON_PNL_CACHE_TTL_SECONDS=300

# Comma-separated list (must be valid JSON list when overriding via env).
# Default already includes Vite dev/preview servers.
# TON_PNL_CORS_ORIGINS='["http://localhost:5173","http://localhost:4173"]'

# --- tonviewer.com proxy mode (optional) -------------------------------------
# Route requests through the tonviewer frontend's tonapi proxy. tonviewer
# returns AES-encrypted bodies (CryptoJS Salted__) which the backend decrypts
# transparently using TON_PNL_TONVIEWER_PASSPHRASE (default works as of writing).
# In our tests we got ~30 RPS on the public proxy with no rate limiting.
#
# TON_PNL_TONAPI_BASE_URL=https://tonviewer.com/api/tonapi
# TON_PNL_TONAPI_HEADERS='{"User-Agent":"Mozilla/5.0 ...","Referer":"https://tonviewer.com/"}'
# TON_PNL_TONAPI_COOKIES='{"_ga":"GA1.1.xxxx"}'
# TON_PNL_TONVIEWER_PASSPHRASE=tv22-asrr11
