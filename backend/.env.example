# Optional API token for tonapi.io — without it the public free tier (~1 RPS) applies.
TON_PNL_TONAPI_TOKEN=

# How many events to scan per wallet (newest first). Increase for power users.
TON_PNL_MAX_EVENTS_PER_WALLET=1000

# Cache TTL for /api/wallet/{address}/pnl, in seconds.
TON_PNL_CACHE_TTL_SECONDS=300

# Comma-separated list (must be valid JSON list when overriding via env).
# Default already includes Vite dev/preview servers.
# TON_PNL_CORS_ORIGINS='["http://localhost:5173","http://localhost:4173"]'
